# Walkie-Talkie server WebSocket URL
# Use Tailscale IP/hostname for Tailnet deployments
SERVER_URL=ws://100.114.167.115:8000/ws/walkie-talkie/radio-bridge-1

# Audio device index (run: python radio_client.py --list-devices)
AUDIO_INPUT_DEVICE=0
AUDIO_OUTPUT_DEVICE=0

# VOX: RMS energy threshold for speech detection (0-32767)
# Start at 500 for a quiet room, raise if noise triggers false positives
VOX_THRESHOLD=500

# Output gain sent to radio mic (1.0 = full LINE-OUT ~1Vrms, will overdrive Baofeng)
# Start at 0.05-0.1 and raise until VOX reliably keys without distortion
VOX_OUTPUT_GAIN=0.08

# GPIO pin (BCM) for hardware PTT. Leave empty to use VOX-only mode.
# Example for Raspberry Pi: PTT_GPIO_PIN=17
PTT_GPIO_PIN=

# Audio format and sample rate (must match server WALKIE_AUDIO_FORMAT / WALKIE_AUDIO_SAMPLE_RATE)
AUDIO_SAMPLE_RATE=8000
AUDIO_FORMAT=ulaw

LOG_LEVEL=INFO
